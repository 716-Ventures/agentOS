[Unit]
Description=Agent OS persistent activities and job supervisor
After=local-fs.target

[Service]
Type=simple
User=agentos
Group=agentos
ExecStart=/usr/local/lib/agent-os/agent-os-core
Restart=on-failure
RestartSec=2
StateDirectory=agent-os-runtime
StateDirectoryMode=0750
RuntimeDirectory=agent-os
RuntimeDirectoryMode=0750
UMask=0007
KillMode=control-group
TimeoutStopSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=384M
TasksMax=128

[Install]
WantedBy=multi-user.target
