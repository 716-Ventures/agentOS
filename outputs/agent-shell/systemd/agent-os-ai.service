[Unit]
Description=Agent OS Gateway tool-using assistant
After=network-online.target agent-os-disk.service agent-os-broker.service agent-os-layout.service
Wants=network-online.target agent-os-disk.service agent-os-broker.service agent-os-layout.service

[Service]
User=agentos-ai
Group=agentos
SupplementaryGroups=agentos-ai agentos-broker
ExecStart=/usr/bin/python3 /usr/local/lib/agent-os/services/assistant.py
Restart=on-failure
RuntimeDirectory=agent-os-ai
RuntimeDirectoryMode=0750
StateDirectory=agent-os-ai
StateDirectoryMode=0700
UMask=0077
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=192M
TasksMax=16

[Install]
WantedBy=multi-user.target
